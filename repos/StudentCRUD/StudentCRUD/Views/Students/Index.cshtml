@model IEnumerable<StudentCRUD.Models.Student>

<h2>Students</h2>

<a asp-action="Create">Add Student</a>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Course</th>
        <th>Age</th>
        <th>Action</th>
    </tr>

    @foreach (var student in Model)
    {
        <tr>
            <td>@student.Name</td>
            <td>@student.Course</td>
            <td>@student.Age</td>
            <td>
                <a asp-action="Edit" asp-route-id="@student.Id">Edit</a> |
                <a asp-action="Delete" asp-route-id="@student.Id">Delete</a>
            </td>
        </tr>
    }
</table>